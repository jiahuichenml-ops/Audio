# Copy this file to .env and fill in real keys locally.
# Empty values are valid for GET /health. Do not commit .env.

# Operator-provided secrets (leave empty in the repository template)
BAILIAN_API_KEY=
DEEPSEEK_API_KEY=
AMAP_API_KEY=

# Local service (project defaults)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8003
PUBLIC_BASE_URL=http://localhost:8003
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Bailian / DashScope Beijing — official paths, configured separately
# ASR: https://help.aliyun.com/zh/model-studio/qwen-asr-api-reference
ASR_MODEL=qwen3-asr-flash
ASR_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# TTS: https://help.aliyun.com/zh/model-studio/qwen-tts-api
TTS_MODEL=qwen3-tts-flash
TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
TTS_VOICE=Cherry
TTS_LANGUAGE_TYPE=Chinese

# DeepSeek — official OpenAI-compatible chat completions
# https://api-docs.deepseek.com/
# Confirmed model id for this project: deepseek-v4-flash
# Official docs currently list deepseek-flash; deepseek-v4-flash remains accepted.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_URL=https://api.deepseek.com/chat/completions

# Amap Web service Key type
AMAP_GEOCODE_URL=https://restapi.amap.com/v3/geocode/geo
AMAP_PLACE_AROUND_URL=https://restapi.amap.com/v3/place/around

TEMP_TTL_HOURS=24
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_S=10
